#!/bin/bash
# Runs a full release when a v* tag is pushed.
# Requires: gh (GitHub CLI, authenticated), git, go
set -euo pipefail

REPO="cainseing/drop-cli"
TAP_REPO="cainseing/homebrew-tap"
FORMULA_PATH="Formula/drop.rb"
SENTINEL="/tmp/.drop-release-in-progress"

# Read pushed refs and find a version tag
VERSION=""
while IFS=' ' read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [[ "${remote_ref}" == refs/tags/v* ]]; then
        VERSION="${remote_ref#refs/tags/}"
        break
    fi
done

# Not a version tag push — nothing to do
[ -z "${VERSION}" ] && exit 0

# Sentinel: prevents this hook from re-triggering when we call git push internally
if [ -f "${SENTINEL}" ]; then
    exit 0
fi

# Only allow releases from the development branch
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [[ "${CURRENT_BRANCH}" != "development" ]]; then
    echo "Error: make publish must be run from the development branch (currently on '${CURRENT_BRANCH}')."
    exit 1
fi
touch "${SENTINEL}"
trap 'rm -f "${SENTINEL}"' EXIT

# Skip if this tag is already on the remote (e.g. git push --tags)
if git ls-remote --tags origin | grep -q "refs/tags/${VERSION}$"; then
    echo "==> Tag ${VERSION} already on remote, skipping release."
    exit 0
fi

VERSION_NO_V="${VERSION#v}"

echo ""
echo "==> Releasing ${VERSION}"
echo ""

# Run tests
echo "==> Running tests..."
go test ./...

# Build all platform binaries with version embedded
echo "==> Building binaries..."
LDFLAGS="-X github.com/cainseing/drop-cli/internal/config.Version=${VERSION}"
mkdir -p bin
GOOS=linux  GOARCH=amd64 go build -ldflags "${LDFLAGS}" -o bin/drop-linux-amd64  ./cmd/drop
GOOS=linux  GOARCH=arm64 go build -ldflags "${LDFLAGS}" -o bin/drop-linux-arm64  ./cmd/drop
GOOS=darwin GOARCH=arm64 go build -ldflags "${LDFLAGS}" -o bin/drop-darwin-arm64 ./cmd/drop
GOOS=darwin GOARCH=amd64 go build -ldflags "${LDFLAGS}" -o bin/drop-darwin-amd64 ./cmd/drop

# Commit binaries, tag at that commit, then push branch and tag
# (sentinel prevents these pushes from re-entering the release flow)
echo "==> Committing binaries..."
BRANCH=$(git rev-parse --abbrev-ref HEAD)
git add bin/
git commit -m "release: build binaries for ${VERSION}"
git tag "${VERSION}"
git push origin "${BRANCH}"

echo "==> Pushing tag ${VERSION}..."
git push origin "${VERSION}"

# Create GitHub Release and upload binaries
echo "==> Creating GitHub Release..."
gh release create "${VERSION}" \
    bin/drop-linux-amd64 \
    bin/drop-linux-arm64 \
    bin/drop-darwin-arm64 \
    bin/drop-darwin-amd64 \
    --title "${VERSION}" \
    --generate-notes

# Compute SHA256 hashes
echo "==> Computing SHA256 hashes..."
DARWIN_ARM64=$(shasum -a 256 bin/drop-darwin-arm64 | awk '{print $1}')
DARWIN_AMD64=$(shasum -a 256 bin/drop-darwin-amd64 | awk '{print $1}')
LINUX_ARM64=$(shasum -a 256  bin/drop-linux-arm64  | awk '{print $1}')
LINUX_AMD64=$(shasum -a 256  bin/drop-linux-amd64  | awk '{print $1}')

# Update brew tap formula
echo "==> Updating brew tap..."
WORK_DIR=$(mktemp -d)
trap 'rm -rf "${WORK_DIR}"; rm -f "${SENTINEL}"' EXIT
git clone --depth=1 "git@github.com:${TAP_REPO}.git" "${WORK_DIR}/tap"
FORMULA="${WORK_DIR}/tap/${FORMULA_PATH}"

sed -i '' "s/version \".*\"/version \"${VERSION_NO_V}\"/" "${FORMULA}"
sed -i '' "s|https://raw.githubusercontent.com/${REPO}/[^/]*/bin/|https://raw.githubusercontent.com/${REPO}/${VERSION}/bin/|g" "${FORMULA}"
sed -i '' "/drop-darwin-arm64/{n; s/sha256 \"[^\"]*\"/sha256 \"${DARWIN_ARM64}\"/;}" "${FORMULA}"
sed -i '' "/drop-darwin-amd64/{n; s/sha256 \"[^\"]*\"/sha256 \"${DARWIN_AMD64}\"/;}" "${FORMULA}"
sed -i '' "/drop-linux-arm64/{n;  s/sha256 \"[^\"]*\"/sha256 \"${LINUX_ARM64}\"/;}"  "${FORMULA}"
sed -i '' "/drop-linux-amd64/{n;  s/sha256 \"[^\"]*\"/sha256 \"${LINUX_AMD64}\"/;}"  "${FORMULA}"

cd "${WORK_DIR}/tap"
git config user.name "$(git -C "${OLDPWD}" config user.name)"
git config user.email "$(git -C "${OLDPWD}" config user.email)"
git add "${FORMULA_PATH}"
git commit -m "drop-cli release ${VERSION}"
git push

# Fast-forward main to match development
echo "==> Updating main..."
git -C "${OLDPWD}" push origin "${BRANCH}":main --force

echo ""
echo "==> Release ${VERSION} complete."
echo ""
